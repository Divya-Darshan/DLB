[gd_scene format=3 uid="uid://bqyj4duv3rrlm"]

[ext_resource type="Script" uid="uid://br8xhqwi3uutn" path="res://player/player.gd" id="1_oul6g"]

[sub_resource type="GDScript" id="GDScript_oul6g"]
script/source = "extends CanvasLayer

@onready var panal: ColorRect = $panal
@onready var speed_input: TextEdit = $panal/speed
@onready var jump_input: TextEdit = $panal/jump
@onready var player: CharacterBody3D = owner

func _ready() -> void:
	load_config()
	panal.visible = false
	if player:
		speed_input.text = str(player.SPEED)
		jump_input.text = str(player.JUMP_VELOCITY)

func _process(delta: float) -> void:
	if panal.visible:
		filter_numeric_input(speed_input)
		filter_numeric_input(jump_input)

	if Input.is_action_just_pressed(\"esc\"):
		panal.visible = !panal.visible
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if panal.visible else Input.MOUSE_MODE_CAPTURED
		
		# Refresh UI text from the player whenever the panel is opened
		if panal.visible and player:
			speed_input.text = str(player.SPEED)
			jump_input.text = str(player.JUMP_VELOCITY)
		
		# Save values when closing the panel
		if not panal.visible:
			save_config()

func filter_numeric_input(box: TextEdit) -> void:
	var current_text = box.text
	var filtered_text = \"\"
	
	for i in range(current_text.length()):
		var c = current_text[i]
		if c.is_valid_int() or c == \".\" or c == \"-\":
			filtered_text += c
			
	if filtered_text != current_text:
		box.text = filtered_text
		box.set_caret_column(filtered_text.length())

func save_config() -> void:
	var speed_val = speed_input.text.strip_edges()
	var jump_val = jump_input.text.strip_edges()
	
	if speed_val.is_valid_float() and jump_val.is_valid_float():
		if player:
			player.SPEED = speed_val.to_float()
			player.JUMP_VELOCITY = jump_val.to_float()
		
		var file = FileAccess.open(\"res://config.txt\", FileAccess.WRITE)
		if file:
			file.store_string(\"SPEED=\" + speed_val + \"\\nJUMP=\" + jump_val)

func load_config() -> void:
	if FileAccess.file_exists(\"res://config.txt\"):
		var file = FileAccess.open(\"res://config.txt\", FileAccess.READ)
		while not file.eof_reached():
			var line = file.get_line().strip_edges()
			if line.begins_with(\"SPEED=\"):
				speed_input.text = line.get_slice(\"=\", 1)
			elif line.begins_with(\"JUMP=\"):
				jump_input.text = line.get_slice(\"=\", 1)
"

